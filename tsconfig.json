{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ESNext",
    "module": "nodenext",
    "strict": true,
    "moduleResolution": "nodenext",
    "maxNodeModuleJsDepth": 1,
    "allowSyntheticDefaultImports": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "#site-components/*": ["./site/_components/*"],
      "#site-layouts/*": ["./site/_layouts/*"],
      "#site-utils/*": ["./site/_utils/*"]
    }
  },
  "include": ["**/*.js", "**/*.ts"],
  "exclude": ["node_modules", "dist", "site/public/lib"]
}
